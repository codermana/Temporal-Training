# Created by https://www.toptal.com/developers/gitignore/api/java
# Edit at https://www.toptal.com/developers/gitignore?templates=java

### Java ###
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# Slides (Marp / npm)
slides/**/node_modules/
slides/**/dist/
.DS_Store

# Local Temporal dev server state
.temporal/

# Scratch area for working the hands-on challenges (see challenges/README.md)
work/

# Standalone Marp template repo (kept for reference; lives in its own .git)
slides-template/

# End of https://www.toptal.com/developers/gitignore/api/java
*.pdf

### Python (polyglot examples — temporalio, run with uv) ###
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# uv resolves from pyproject.toml on demand; lockfiles are regenerated locally.
uv.lock

### Go (polyglot examples — go.temporal.io/sdk) ###
# `go build` in a main-package dir drops an extensionless binary named after the
# dir. Prefer `go run .`. These get ignored so they never get committed.
# (go.mod / go.sum ARE committed for reproducible lab builds.)
examples/**/go/*.test
*.out
examples/runnable/*/go/parallel
examples/runnable/*/go/kafka-bridge
examples/runnable/*/go/saga
examples/runnable/*/go/continueasnew
examples/runnable/*/go/aws
examples/runnable/*/go/signals-queries-updates
examples/runnable/*/go/schedules
examples/runnable/*/go/retries-heartbeats
examples/runnable/*/go/child-workflows
examples/runnable/*/go/testing
examples/runnable/*/go/determinism-replay
